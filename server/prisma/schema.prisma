// Schéma de base de données ShopCraft
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles utilisateur
enum Role {
  USER
  ADMIN
}

// Statut d'un ticket d'aide
enum TicketStatus {
  OPEN
  ANSWERED
}

// Statut d'une conversation de chat client <-> support
enum ChatStatus {
  OPEN // en attente d'une réponse du support
  ACTIVE // un administrateur est engagé dans la conversation
  CLOSED // conversation clôturée
}

// Type de notification (cloche)
enum NotificationType {
  NEW_TICKET // nouvelle demande envoyée aux administrateurs
  TICKET_REPLY // réponse (admin -> utilisateur ou utilisateur -> admin)
}

// Statuts possibles d'une commande
enum OrderStatus {
  PENDING // en attente
  SHIPPED // expédiée
  DELIVERED // livrée
  CANCELLED // annulée
}

// Méthode de paiement choisie par le client au moment de la commande
enum PaymentMethod {
  CARD // carte bancaire (payée en ligne via Stripe)
  CASH // espèces à la livraison
}

// Statut de paiement d'une commande
enum PaymentStatus {
  PAID // paiement confirmé (carte en ligne)
  UNPAID // paiement en attente (espèces à la livraison)
}

// Compte utilisateur (client ou admin)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String? // stocké haché (bcrypt) — null pour les comptes Google
  provider    String   @default("local") // local | google
  googleId    String?  @unique // identifiant Google (si connexion via Google)
  role        Role     @default(USER)
  displayName String? // nom affiché (modifiable dans le profil)
  avatar      String? // URL de la photo de profil (optionnelle)
  createdAt   DateTime @default(now())

  orders  Order[]
  reviews Review[]
  supportTickets   SupportTicket[]
  ticketMessages   TicketMessage[]
  notifications    Notification[]
  chatRooms        ChatRoom[]
  chatMessages     ChatMessage[]
}

// Produit du catalogue
model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  category    String
  images      String[] // URLs des images (tableau)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
  reviews    Review[]

  @@index([category])
  @@index([name])
}

// Commande passée par un utilisateur
model Order {
  id                    String        @id @default(cuid())
  userId                String
  status                OrderStatus   @default(PENDING)
  total                 Decimal       @db.Decimal(10, 2)
  stripePaymentIntentId String?       @unique // identifiant Stripe du paiement (si payé via Stripe)
  createdAt             DateTime      @default(now())

  // ---- Informations de livraison (formulaire rempli au checkout) ----
  fullName   String
  phone      String
  email      String // email de livraison (pré-rempli avec le compte)
  address    String
  city       String
  postalCode String
  country    String
  note       String? // remarque optionnelle (livraison, etc.)

  // ---- Paiement ----
  paymentMethod PaymentMethod @default(CARD) // carte bancaire | espèces à la livraison
  paymentStatus PaymentStatus @default(PAID) // payée | à payer à la livraison

  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]

  @@index([userId])
}

// Ligne d'une commande (produit + quantité + prix figé au moment de l'achat)
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

// Avis / note laissé par un utilisateur sur un produit
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // de 1 à 5 étoiles
  comment   String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])

  @@unique([productId, userId]) // un seul avis par utilisateur et par produit
}

// Ticket d'aide créé par un utilisateur, traité par les administrateurs
model SupportTicket {
  id        String        @id @default(cuid())
  userId    String
  subject   String // objet du problème (ex: "Commande jamais reçue")
  status    TicketStatus  @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt // mis à jour à chaque message

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]
  notifications Notification[]

  @@index([userId])
}

// Message dans un ticket (un ticket est un fil de discussion)
model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Notification affichée dans la cloche
model Notification {
  id         String           @id @default(cuid())
  userId     String // destinataire de la notification
  type       NotificationType
  title      String
  body       String
  ticketId   String? // ticket lié (pour ouvrir la conversation)
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

// Conversation de chat en direct entre un client et le support (administrateurs).
// Un client dispose d'une seule conversation active ; celle-ci est marquée
// OPEN à sa création, puis ACTIVE quand un admin y répond et CLOSED à la clôture.
model ChatRoom {
  id        String      @id @default(cuid())
  userId    String // le client propriétaire de la conversation
  status    ChatStatus  @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

// Message d'un chat (un chat est un fil de discussion en temps réel).
model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId])
}