# Dépendances
node_modules/

# Environnement (ne jamais committer les secrets)
# On ignore TOUTES les variantes de .env (server/.env, client/.env, .env.local...)
# sauf .env.example (le modèle à copier par les développeurs).
.env
.env.*
!.env.example

# Builds
dist/
build/

# Fichiers uploadés par les utilisateurs (stockés localement)
server/uploads/*
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*

# Système / OS
.DS_Store
Thumbs.db

# Éditeurs
.vscode/
.idea/