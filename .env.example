# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopcraft"

# --- Authentification JWT ---
JWT_SECRET="changez-cette-cle-secrete"

# --- Connexion Google (bouton "Continuer avec Google") ---
# Client ID Google (public) : https://console.cloud.google.com/apis/credentials
# Laissez vide pour désactiver la connexion Google.
GOOGLE_CLIENT_ID="xxxxxxx.apps.googleusercontent.com"

# --- Stripe (mode test) ---
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
STRIPE_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"
# Secret du webhook : obtenu avec `stripe listen --forward-to localhost:5000/webhook/stripe`
# (ou dans le dashboard Stripe > Webhooks). Nécessaire uniquement en production / pour 3DS.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# --- Serveur / Client ---
CLIENT_URL="http://localhost:5173"
PORT=5000